# ---------------------------------------------------------------
# A linguagem do projeto e livre. Este arquivo cobre os restos mais
# comuns de varias linguagens.
#
# IMPORTANTE: a pasta em que o executavel e gerado (dist/, bin/,
# target/, ...) NAO deve ser ignorada, porque o executavel faz
# parte da entrega. Se acrescentar regras, revise este ponto.
# ---------------------------------------------------------------

# Artefatos intermediarios de compilacao
build/
obj/
out/
*.o
*.obj
*.class
*.spec

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Java, C#, Node
*.jar.tmp
node_modules/

# Editores
.vscode/
.idea/
*.swp

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Saidas geradas pelo simulador durante o uso
saida/

# LaTeX
*.aux
*.log
*.out
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk

# Saida intermediaria do PyInstaller. O Simulador.exe e copiado para a raiz
# do repositorio e versionado normalmente; so a pasta dist/ e ignorada.
dist/
